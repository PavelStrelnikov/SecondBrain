# --- PostgreSQL (отдельный экземпляр, не тот, что у CRM) ---
POSTGRES_USER=brain
POSTGRES_PASSWORD=change_me
POSTGRES_DB=brain_work

# --- Ядро ---
DATABASE_URL=postgresql+asyncpg://brain:change_me@db:5432/brain_work
# Токен, которым приложение на телефоне подписывает запросы. Сгенерируй: openssl rand -hex 32
DEVICE_TOKEN=change_me_openssl_rand_hex_32
# Пароль к странице «здоровье» в браузере (HTTP Basic, логин brain)
HEALTH_PASSWORD=change_me
TZ=Asia/Jerusalem
